{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GV100HRunManifest",
  "description": "Immutable Machine-Readable Execution Evidence Manifest for Local AI Agent Qualification",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "experiment_arm",
    "target_repo",
    "base_commit",
    "model_id",
    "runtime",
    "framework_commit",
    "contract_id",
    "hardware",
    "evidence",
    "outcome"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique run execution UUID"
    },
    "task_id": {
      "type": "string",
      "description": "Benchmark or engineering task identifier (e.g. GV100H-M3-CASE-001)"
    },
    "benchmark_task_id": {
      "type": ["string", "null"]
    },
    "pair_id": {
      "type": ["string", "null"]
    },
    "repetition": {
      "type": ["integer", "null"]
    },
    "experiment_arm": {
      "type": "string",
      "enum": ["arm_a_prompt_only", "arm_b_governed_sidecar", "benchmark_baseline", "synthetic_replay"]
    },
    "target_repo": {
      "type": "string",
      "description": "Target repository being operated on (e.g. Gavin0099/uvm-agent-lab)"
    },
    "base_commit": {
      "type": "string",
      "description": "Baseline Git SHA before execution"
    },
    "head_commit": {
      "type": ["string", "null"],
      "description": "Git SHA after patch application if committed"
    },
    "model_id": {
      "type": "string"
    },
    "model_hash": {
      "type": ["string", "null"]
    },
    "runtime": {
      "type": "string",
      "enum": ["llama.cpp", "vllm", "sglang", "transformers", "mock_replay"]
    },
    "runtime_commit": {
      "type": ["string", "null"]
    },
    "quantization": {
      "type": ["string", "null"],
      "enum": ["Q4_K_M", "Q8_0", "AWQ_4BIT", "GPTQ_4BIT", "FP16", "FP8", "NONE", null]
    },
    "framework_commit": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_hash": {
      "type": ["string", "null"]
    },
    "execution_contract_id": {
      "type": ["string", "null"]
    },
    "execution_contract_hash": {
      "type": ["string", "null"]
    },
    "benchmark_case_hash": {
      "type": ["string", "null"]
    },

    "knowledge_repo": {
      "type": ["string", "null"]
    },
    "knowledge_repo_commit": {
      "type": ["string", "null"]
    },
    "knowledge_manifest_hash": {
      "type": ["string", "null"]
    },
    "dataset_hash": {
      "type": ["string", "null"]
    },
    "client": {
      "type": ["string", "null"],
      "enum": ["cline", "continue", "direct_gateway", "harness_internal", null]
    },
    "client_version": {
      "type": ["string", "null"]
    },

    "interception_mode": {
      "type": "string",
      "enum": ["ENFORCED", "POST_HOC", "UNSUPPORTED"]
    },
    "sampling": {
      "type": ["object", "null"],
      "properties": {
        "temperature": { "type": ["number", "null"] },
        "top_p": { "type": ["number", "null"] },
        "max_tokens": { "type": ["integer", "null"] }
      }
    },
    "hardware": {
      "type": "object",
      "required": ["gpu_count", "gpu_model"],
      "properties": {
        "gpu_count": { "type": "integer" },
        "gpu_model": { "type": "string" },
        "hardware_observed": { "type": ["boolean", "null"] },
        "driver_version": { "type": ["string", "null"] },
        "cuda_version": { "type": ["string", "null"] },
        "vram_total_gb": { "type": ["number", "null"] },
        "vram_peak_used_gb": { "type": ["number", "null"] }
      }
    },
    "timing": {
      "type": ["object", "null"],
      "properties": {
        "ttft_ms": { "type": ["number", "null"] },
        "prompt_tps": { "type": ["number", "null"] },
        "decode_tps": { "type": ["number", "null"] },
        "wall_clock_sec": { "type": ["number", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["git_diff_sha256"],
      "properties": {
        "evidence_schema_version": { "type": ["string", "null"], "enum": ["2", null] },
        "git_diff_sha256": { "type": "string" },
        "changed_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workspace_tree_sha256": { "type": ["string", "null"] },
        "target_file": { "type": ["string", "null"] },
        "target_file_sha256": { "type": ["string", "null"] },
        "file_snapshots_sha256": { "type": ["string", "null"] },
        "tool_trace_sha256": { "type": ["string", "null"] },
        "verification_sha256": { "type": ["string", "null"] },
        "endpoint_observed": { "type": ["boolean", "null"] },
        "eda_backend": { "type": ["string", "null"] },
        "qualification_admissible": { "type": ["boolean", "null"] },
        "build_command": { "type": ["string", "null"] },
        "build_exit_code": { "type": ["integer", "null"] },
        "build_log_sha256": { "type": ["string", "null"] },
        "test_command": { "type": ["string", "null"] },
        "test_exit_code": { "type": ["integer", "null"] },
        "test_log_sha256": { "type": ["string", "null"] }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["status", "false_success"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "timeout", "scope_violation", "endpoint_unavailable"]
        },
        "false_success": { "type": "boolean" },
        "failure_class": {
          "type": ["string", "null"],
          "enum": [
            "MODEL_REASONING_FAIL",
            "TOOL_CALL_FAIL",
            "CONTEXT_FAIL",
            "BUILD_FAIL",
            "TEST_FAIL",
            "HALLUCINATED_SUCCESS",
            "SCOPE_VIOLATION",
            "TIMEOUT",
            "ENDPOINT_UNAVAILABLE",
            null
          ]
        },
        "human_acceptance_rating": {
          "type": ["string", "null"],
          "enum": ["A", "B", "C", "D", null]
        }
      }
    }
  }
}

